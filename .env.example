APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# ---------------------------------------------------------------------------------------------------------------
# Tenancy: como a aplicação sabe de que escola é cada pedido. Mudar qualquer destas variáveis exige reiniciar.
#
# Instalação PARTILHADA (vários clientes no mesmo servidor), TENANCY_MODO=dominio:
#   - Cada escola tem o seu domínio (escola1.mositec.ao, ou o do cliente apontado ao servidor), registado em
#     Plataforma > Escolas > Nova. Um domínio desconhecido dá 404.
#   - O painel da Plataforma vive num host central: TENANCY_HOSTS_CENTRAIS=painel.mositec.ao (abre em /plataforma).
#   - TENANCY_DOMINIOS_RAIZ: os domínios da MosiTec, onde ficam os subdomínios das escolas.
#   - Precisa de um domínio da MosiTec, com subdomínios curinga (*.mositec.ao) e HTTPS.
#
# Instalação DEDICADA (um servidor por cliente, uma só escola), TENANCY_MODO=unico:
#   - A aplicação serve a única escola em qualquer endereço (domínio do cliente, IP ou *.ethiodeploy.app de teste).
#   - O painel da Plataforma abre em /plataforma desse mesmo domínio: não é preciso um segundo domínio nem
#     TENANCY_HOSTS_CENTRAIS (deixar vazio). Crie a escola em /plataforma/escolas/nova (o domínio é ignorado).
#   - Exige EXACTAMENTE uma escola: com duas, a escola deixa de abrir. Proteja /plataforma no servidor do cliente.
# ---------------------------------------------------------------------------------------------------------------
# dominio: tenant resolvido pelo host | unico: instalação com um só tenant
TENANCY_MODO=dominio
# Hosts sem tenant onde vive o painel da Plataforma, separados por vírgulas. Vazio = painel só em /plataforma (modo unico)
# ou desactivado (modo dominio).
# Não definir SESSION_DOMAIN com um domínio-pai em produção (ver docs/tenancy.md, secção Plataforma).
TENANCY_HOSTS_CENTRAIS=
# Duração da sessão do painel da Plataforma, em minutos (por omissão 60)
# PLATAFORMA_SESSAO_MINUTOS=60
TENANCY_DOMINIOS_RAIZ=mositec.ao

# Proxies em que a aplicação confia para saber o IP e o esquema (http/https) do cliente. Vazio = nenhum (por omissão).
# Atrás do proxy de uma plataforma de alojamento (ethiodeploy, etc.) é OBRIGATÓRIO, senão a aplicação julga que o pedido é
# http e gera redirects http://, que o browser bloqueia: ficam sem feedback o criar escola, recuperar administrador, etc.
# `*` = todos (só se a aplicação nunca for acedida directamente) ou uma lista de IPs/redes: TRUSTED_PROXIES=10.0.0.0/8
# Só X-Forwarded-For e X-Forwarded-Proto são considerados, nunca X-Forwarded-Host. Em produção: SESSION_SECURE_COOKIE=true.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Segue FORCAR_HTTPS por omissão (config/session.php); só definir aqui para sobrepor
# SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Ligar quando houver HTTPS: activa HSTS e o cookie de sessão `secure`. Em HTTP interno deixar false.
FORCAR_HTTPS=false
HSTS_MAX_AGE=86400
CSP_REPORT_ONLY=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync: os jobs correm no próprio pedido (sem worker). Em produção com worker (queue:work) use database.
QUEUE_CONNECTION=sync
# Jobs pesados (exportações, importações, propinas, multas): fila `pesado` na mesma tabela `jobs`, com worker próprio
# (`php artisan queue:work database_pesado --queue=pesado --timeout=3600`). Segue QUEUE_CONNECTION=sync sozinha.
# O retry_after tem de ficar acima do maior timeout dos jobs (3600 s).
# QUEUE_PESADA_CONNECTION=database_pesado
# DB_QUEUE_PESADO_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis (opcional): para usar, instalar a extensão phpredis e mudar CACHE_STORE e SESSION_DRIVER para redis (ver docs/performance.md)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
